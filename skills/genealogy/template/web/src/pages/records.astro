---
import Base from '../layouts/Base.astro';
import PersonLink from '../components/PersonLink.astro';
import { recordList, dateKey, href } from '../lib/data.js';
const list = [...recordList].sort((a, b) => dateKey(a.date) - dateKey(b.date));
const kinds = [...new Set(list.map((r) => r.kindName))];
---
<Base title="Register records">
  <h1>Register records</h1>
  <p class="lead">All {list.length} records the family tree is built on – in chronological order. Each has a crop of the image with the relevant entry marked, the full resolution and a link to the archive. What is still missing from the registers or contradicts itself is listed under <a href="/open-questions/">open questions</a>.</p>
  <p class="chips">
    <button class="chip" data-k="" type="button">all</button>
    {kinds.map((k) => <button class="chip" data-k={k} type="button">{k}</button>)}
  </p>
  <div class="table-box"><table>
    <thead><tr><th>Date</th><th>Kind</th><th>Record</th><th>Concerns</th></tr></thead>
    <tbody>
      {list.map((r) => (
        <tr data-kind={r.kindName}>
          <td class="small" style="white-space:nowrap">{r.date}</td>
          <td class="small">{r.kindName}</td>
          <td><a href={href.record(r.key)}>{r.title}</a><div class="small muted">{r.volume || r.vdesc}</div>
            {r.orig && (
              <details class="transcript">
                <summary>Register text and translation</summary>
                <div class="tr-grid"><div><h4>Transcription of the original</h4><p class="tr-orig">{r.orig}</p></div><div><h4>Translation</h4><p class="tr-translation">{r.translation}</p></div></div>
              </details>
            )}
          </td>
          <td class="small">{r.people.map((s, i) => <>{i > 0 && ', '}<PersonLink slug={s} showYears={false} /></>)}</td>
        </tr>
      ))}
    </tbody>
  </table></div>
  <script>
    document.querySelectorAll<HTMLButtonElement>('button[data-k]').forEach((b) =>
      b.addEventListener('click', () => {
        document.querySelectorAll<HTMLTableRowElement>('tr[data-kind]').forEach((tr) => {
          tr.hidden = !!b.dataset.k && tr.dataset.kind !== b.dataset.k;
        });
      })
    );
  </script>
</Base>
