---
import Base from '../../layouts/Base.astro';
import { docs, config, lineByK, href } from '../../lib/data.js';
import { Content, frontmatter } from '../../generated/story.md';
const line = lineByK[config.story?.line ?? 8];
// More stories: web/src/generated/story_<line>.md (from data/story_<line>.md, if the exporter provides them),
// shown below the main story, each with its own anchor (#story-<line>).
const more = Object.entries(import.meta.glob('../../generated/story_*.md', { eager: true }))
  .map(([path, mod]) => ({ id: path.replace(/^.*story_(.+)\.md$/, '$1'), ...mod }))
  .sort((a, b) => a.id.localeCompare(b.id, 'en'));
---
<Base title={frontmatter.title}>
  <p class="crumbs">{line && <><a href={href.line(line.slug)}>{line.name} line</a> · </>}<a href="/curiosities/">more curiosities</a></p>
  <h1>{frontmatter.title}</h1>
  {frontmatter.lead && <p class="lead">{frontmatter.lead}</p>}
  <div class="prose"><Content /></div>

  {more.length > 0 && <nav class="small" aria-label="More stories"><p>More stories: {more.map((s, i) => <>{i > 0 && ' · '}<a href={`#story-${s.id}`}>{s.frontmatter?.title || s.id}</a></>)}</p></nav>}
  {more.map((s) => (
    <section id={`story-${s.id}`}>
      <h2>{s.frontmatter?.title || s.id}</h2>
      {s.frontmatter?.lead && <p class="lead">{s.frontmatter.lead}</p>}
      <div class="prose"><s.Content /></div>
    </section>
  ))}

  <div class="next-step">
    <p><strong>Want more?</strong> You will find more discoveries from the family tree among the curiosities.</p>
    <a class="btn" href="/curiosities/">Curiosities from the family tree →</a>
  </div>

  {docs.length > 0 && (
    <>
      <h2>Family documents and photographs</h2>
      <div class="docs">
        {docs.map((d) => (
          <figure><a href={`/img/${d.img}.jpg`} target="_blank" rel="noopener"><img src={`/img/${d.img}.jpg`} alt={d.caption} loading="lazy" /></a><figcaption>{d.caption}</figcaption></figure>
        ))}
      </div>
    </>
  )}
</Base>
